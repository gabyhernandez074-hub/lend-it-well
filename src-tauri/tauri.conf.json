{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pocalana",
  "version": "0.1.0",
  "identifier": "com.pocalana.inventory",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "Pocalana",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Library inventory management",
    "longDescription": "Manage library inventory, loans, returns, and barcode printing."
  }
}
